# Analytics & Ads Environment Variables
# Copy this file to .env.local and fill in real values
# NEVER commit .env.local to git

# Google Tag Manager
NEXT_PUBLIC_GTM_ID=GTM-NKSQN8N

# HubSpot
NEXT_PUBLIC_HUBSPOT_ID=8323542

# Facebook Pixel (get from Facebook Events Manager)
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Analytics 4 (measurement ID from GA4 property)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Ads (conversion ID for tracking)
NEXT_PUBLIC_GOOGLE_ADS_ID=
